{
  "name": "cleanavenir",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev:express": "nodemon",
    "start:express": "node dist/server.js",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "migrate:push": "npx drizzle-kit push",
    "migrate:generate": "npx drizzle-kit generate",
    "migrate:up": "npx drizzle-kit migrate",
    "db:reset": "rm -f dev.sqlite && touch dev.sqlite && npm run migrate:up && npm run db:seed:all:drizzle",
    "db:reset:win": "powershell -NoProfile -Command \"If (Test-Path dev.sqlite) { Remove-Item dev.sqlite -Force }; New-Item dev.sqlite -ItemType File | Out-Null; npx drizzle-kit migrate; npm run db:seed:all:drizzle\"",
    "db:seed:users:drizzle": "npx tsx scripts/drizzleSeeds/seed-users.ts",
    "db:seed:advisors:drizzle": "npx tsx scripts/drizzleSeeds/seed-advisors.ts",
    "db:seed:clients:drizzle": "npx tsx scripts/drizzleSeeds/seed-clients.ts",
    "db:seed:savingProducts:drizzle": "npx tsx scripts/drizzleSeeds/seed-savingProducts.ts",
    "db:seed:accounts:drizzle": "npx tsx scripts/drizzleSeeds/seed-accounts.ts",
    "db:seed:companies-stocks:drizzle": "npx tsx scripts/drizzleSeeds/seed-companies-stocks.ts",
    "db:seed:system-stocks-holdings:drizzle": "npx tsx scripts//drizzleSeeds/seed-system-stocks-holdings.ts",
    "db:seed:all:drizzle": "npm run db:seed:users:drizzle && npm run db:seed:advisors:drizzle && npm run db:seed:clients:drizzle && npm run db:seed:savingProducts:drizzle && npm run db:seed:accounts:drizzle && npm run db:seed:companies-stocks:drizzle && npm run db:seed:system-stocks-holdings:drizzle",
    "db:studio": "npx drizzle-kit studio",
    "test:db": "npx tsx src/index.ts",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop cleanavenir-backend",
    "pm2:restart": "pm2 restart cleanavenir-backend",
    "pm2:logs": "pm2 logs cleanavenir-backend",
    "pm2:monit": "pm2 monit"
  },
  "lint-staged": {
    "*.{ts,js,json,md}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Misokka/cleanavenir.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Misokka/cleanavenir/issues"
  },
  "homepage": "https://github.com/Misokka/cleanavenir#readme",
  "devDependencies": {
    "@types/cookie": "^0.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^24.9.1",
    "@types/nodemailer": "^7.0.4",
    "@types/nodemon": "^1.19.6",
    "@types/pdfkit": "^0.17.4",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "drizzle-kit": "^0.18.1",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "nodemon": "^3.1.11",
    "prettier": "^3.6.2",
    "prisma": "^7.1.0",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.1.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node-cron": "^3.0.11",
    "bcrypt": "^6.0.0",
    "cookie": "^1.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.6",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.12",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.3",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0",
    "winston": "^3.18.3"
  }
}
