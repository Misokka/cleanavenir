datasource db {
  provider = "postgresql"
}
generator client {
  provider = "prisma-client-js"
}

model User {
  userIdentifier    String   @id @default(cuid())
  firstname         String
  lastname          String
  email             String   @unique
  password          String
  role UserRole
  createdAt         DateTime @default(now())
  emailVerifiedAt   DateTime?
  active            Boolean @default(true)

  client Client?
  director Director?
  advisor Advisor?
  emailVerificationToken EmailVerificationToken[]
  messages Message[]
}

enum UserRole {
  CLIENT
  DIRECTOR
  ADVISOR
  SYSTEM
}

model EmailVerificationToken {
  tokenIdentifier String @id
  userIdentifier String
  tokenHash String
  expiresAt DateTime
  createdAt DateTime
  usedAt DateTime?

  user User @relation(fields: [userIdentifier], references: [userIdentifier])
}

model Client {
  clientIdentifier String   @id @default(cuid())
  userIdentifier String   @unique
  advisorIdentifier String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userIdentifier], references: [userIdentifier])
  advisor Advisor @relation(fields: [advisorIdentifier], references: [advisorIdentifier])
  savingAccounts SavingAccount[]
  orders Order[]
  portfolio Portfolio?
  bankAccounts BankAccount[]
  discussions Discussion[]
  loans Loan[]
  beneficiaries Beneficiary[]
}

model Director{
  directorIdentifier    String      @id @default(cuid())
  userIdentifier        String   @unique
  createdAt             DateTime @default(now())

  user User @relation(fields: [userIdentifier], references: [userIdentifier])
}

model Advisor{
  advisorIdentifier         String     @id @default(cuid())
  userIdentifier            String     @unique
  createdAt                 DateTime   @default(now())

  user User                            @relation(fields: [userIdentifier], references: [userIdentifier])
  clients Client[]
  discussions Discussion[]
  loans Loan[]
  fromDiscussionTransfers DiscussionTransfer[] @relation("TransfersFromAdvisor")
  toDiscussionTransfers DiscussionTransfer[] @relation("TransfersToAdvisor")
}

model BankAccount{
  accountIdentifier String @id @default(cuid())
  clientIdentifier String
  iban String @unique
  label String
  balance Int @default(0)

  client Client @relation(fields: [clientIdentifier], references: [clientIdentifier])
  forBankAccountTransactions Transaction[] @relation("ForBankAccount")
  FromBankAccountTransactions Transaction[] @relation("FromBankAccount")
  ToBankAccountTransactions Transaction[] @relation("ToBankAccount")
}

model Transaction{
  transactionIdentifier String @id @default(cuid())
  bankAccountIdentifier String
  amount Int
  direction TransactionDirection
  type TransactionType
  description String
  currency String @default("EUR")
  createdAt DateTime @default(now())
  fromAccountIdentifier String?
  toAccountIdentifier String?
  toSavingAccountIdentifier String?

  bankAccount BankAccount @relation("ForBankAccount", fields: [bankAccountIdentifier], references: [accountIdentifier])
  fromBankAccount BankAccount? @relation("FromBankAccount", fields: [fromAccountIdentifier], references: [accountIdentifier])
  toBankAccount BankAccount? @relation("ToBankAccount", fields: [toAccountIdentifier], references: [accountIdentifier])
  toSavingAccount SavingAccount? @relation("ToSavingAccount", fields: [toSavingAccountIdentifier], references: [accountIdentifier])

}

enum TransactionType {
  TRANSFER
  LOAN_PAYMENT
  LOAN_DISBURSEMENT
  STOCK_PURCHASE
  STOCK_SALE
  ORDER_REFUND
  SAVINGS_INTEREST
  INITIAL_DEPOSIT
}

enum  TransactionDirection {
  DEBIT
  CREDIT
}

model Company{
  companyIdentifier String @id @default(cuid())
  name String
  description String

  stock Stock?
}

model Discussion {
  discussionIdentifier String @id @default(cuid())
  clientIdentifier String
  createdAt DateTime @default(now())
  advisorIdentifier String?
  subject String?
  status DiscussionStatus

  client Client @relation(fields: [clientIdentifier], references: [clientIdentifier])
  advisor Advisor? @relation(fields: [advisorIdentifier], references: [advisorIdentifier])
  discussionTransfers DiscussionTransfer[]
  messages Message[]
}

enum DiscussionStatus {
  PENDING
  ASSIGNED
  CLOSED
}

model DiscussionTransfer {
  transferIdentifier String @id
  discussionIdentifier String
  fromAdvisorIdentifier String
  toAdvisorIdentifier String
  reason String?
  createdAt DateTime

  discussion Discussion @relation(fields: [discussionIdentifier], references: [discussionIdentifier])
  fromAdvisor Advisor @relation("TransfersFromAdvisor", fields: [fromAdvisorIdentifier], references: [advisorIdentifier])
  toAdvisor Advisor @relation("TransfersToAdvisor", fields: [toAdvisorIdentifier], references: [advisorIdentifier])
}

model Message {
  messageIdentifier String @id
  discussionIdentifier String
  senderIdentifier String
  senderRole SenderRole
  content String
  createdAt DateTime

  discussion Discussion @relation(fields: [discussionIdentifier], references: [discussionIdentifier])
  sender User @relation(fields: [senderIdentifier], references: [userIdentifier])
}

enum SenderRole {
  CLIENT
  ADVISOR
}
model Loan {
  loanIdentifier String @id @default(cuid())
  clientIdentifier String
  advisorIdentifier String
  loanAmount Int
  durationInMonth Int
  mensualities Int
  insuranceMensualities Int
  remainingAmountToPay Int
  annualInterestRate Int
  annualInsuranceRate Int
  status LoanStatus
  createdAt DateTime @default(now())
  lastPaidAt DateTime?
  nextToPayAt DateTime?

  client Client @relation(fields: [clientIdentifier], references: [clientIdentifier])
  advisor Advisor @relation(fields: [advisorIdentifier], references: [advisorIdentifier])
}

enum LoanStatus {
  PENDING
  ACTIVE
  PAID_OFF
  REJECTED
}

model Stock {
  stockIdentifier String @id @default(cuid())
  companyIdentifier String @unique
  ticker String @unique
  price Int
  isAvailable Boolean @default(true)
  createdAt DateTime

  company Company @relation(fields: [companyIdentifier], references: [companyIdentifier])
  orders Order[]
  holding Holding[]
  trades Trade[]
  priceHistory StockPriceHistory[]

}

model Portfolio {
  portfolioIdentifier String @id @default(cuid())
  clientIdentifier String @unique
  createdAt DateTime

  client Client @relation(fields: [clientIdentifier], references: [clientIdentifier])
  holdings Holding[]
}

model Holding {
  holdingIdentifier String @id @default(cuid())
  portfolioIdentifier String
  stockIdentifier String
  quantity Int
  averagePrice Int

  portfolio Portfolio @relation(fields: [portfolioIdentifier], references: [portfolioIdentifier])
  stock Stock @relation(fields: [stockIdentifier], references: [stockIdentifier])
}

model Order {
  orderIdentifier String @id @default(cuid())
  clientIdentifier String
  stockIdentifier String
  orderType OrderType
  initialQuantity Int
  remainingQuantity Int
  limitPrice Int
  status OrderStatus
  blockedMoneyAmount Int?
  remainingBlockedMoneyAmount Int?
  blockedStockQuantity Int?
  sellerHoldingAveragePrice Int?
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientIdentifier], references: [clientIdentifier])
  stock Stock @relation(fields: [stockIdentifier], references: [stockIdentifier])

  buyTrades Trade[] @relation("BuyOrder")
  sellTrades Trade[] @relation("SellOrder")
}

enum OrderType {
  BUY
  SELL
}

enum OrderStatus {
  PENDING
  PARTIALLY_FILLED
  EXECUTED
  CANCELLED
}

model Trade {
  tradeIdentifier String @id @default(cuid())
  stockIdentifier String @default(cuid())
  buyOrderIdentifier String @default(cuid())
  sellOrderIdentifier String @default(cuid())
  quantity Int
  price Int
  status TradeStatus
  createdAt DateTime

  stock Stock @relation(fields: [stockIdentifier], references: [stockIdentifier])
  buyOrder Order @relation("BuyOrder", fields: [buyOrderIdentifier], references: [orderIdentifier])
  sellOrder Order @relation("SellOrder", fields: [sellOrderIdentifier], references: [orderIdentifier])

}

enum TradeStatus {
  PENDING_SETTLEMENT
  SETTLED
}

model SavingAccount {
  accountIdentifier String @id @default(cuid())
  clientIdentifier String @default(cuid())
  productIdentifier String @default(cuid())
  iban String
  label String
  balance Int
  createdAt DateTime

  client Client @relation(fields: [clientIdentifier], references: [clientIdentifier])
  savingProduct SavingProduct @relation(fields: [productIdentifier], references: [savingProductIdentifier])
  transactions Transaction[] @relation("ToSavingAccount")
}

model SavingProduct {
  savingProductIdentifier String @id @default(cuid())
  label String @unique
  rate Int
  rateUpdatedAt DateTime?

  savingAccounts SavingAccount[]
}

model Beneficiary {
  beneficiaryIdentifier String @id @default(cuid())
  clientIdentifier String
  iban String
  label String
  accountName String?
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientIdentifier], references: [clientIdentifier])
}

model StockPriceHistory {
  stockPriceIdentifier String @id @default(cuid())
  stockIdentifier String
  price Int
  recordedAt DateTime @default(now())

  stock Stock @relation(fields: [stockIdentifier], references: [stockIdentifier])
}