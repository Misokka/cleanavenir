{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "rootDir": ".",
    "outDir": "dist",
    "noEmit": true,
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"],
    "experimentalDecorators": true, // INDISPENSABLE pour NestJS
    "emitDecoratorMetadata": true
  },
  "include": ["src", "scripts", "tests", "prisma.config.ts"],
  "exclude": [
    
  ]
}
